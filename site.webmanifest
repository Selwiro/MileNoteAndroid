{
  "name": "里程志 MileNote",
  "short_name": "里程志",
  "description": "本地优先的 Android 用车小助手：多车管理、日常开销记录、油耗与电耗分析、保养到期提醒。无需账号，数据默认保存在本机。",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display": "browser",
  "background_color": "#F5F9FB",
  "theme_color": "#F5F9FB",
  "icons": [
    {
      "src": "assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
