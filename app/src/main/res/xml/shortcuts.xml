<?xml version="1.0" encoding="utf-8"?>
<!--
  长按应用图标的快捷方式：记一笔 / 油费识别。
  intent 只带自定义 action，MainActivity 解析后交给 MileNoteViewModel 打开对应入口。
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_entry"
        android:shortcutId="new_entry"
        android:shortcutLongLabel="@string/shortcut_new_entry_long"
        android:shortcutShortLabel="@string/shortcut_new_entry_short">
        <intent
            android:action="com.milenote.android.SHORTCUT_NEW_ENTRY"
            android:targetClass="com.milenote.android.MainActivity"
            android:targetPackage="com.milenote.android" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutId="scan_receipt"
        android:shortcutLongLabel="@string/shortcut_scan_long"
        android:shortcutShortLabel="@string/shortcut_scan_short">
        <intent
            android:action="com.milenote.android.SHORTCUT_OCR"
            android:targetClass="com.milenote.android.MainActivity"
            android:targetPackage="com.milenote.android" />
    </shortcut>

</shortcuts>
