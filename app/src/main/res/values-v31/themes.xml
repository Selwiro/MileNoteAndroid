<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ 系统 SplashScreen 使用 android: 命名空间属性；背景色由 @color/window_background 按深/浅色自动解析 -->
    <style name="Theme.MileNote.Splash" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.MileNote</item>
    </style>
</resources>
